# dependencies and local state
node_modules/
server/var/
*.log
# secrets: only the documented template is tracked
.env
.env.*
!.env.example
# build output is reproducible from `node build.mjs`
dist/
!prototype/dist/

.vercel
.env*
# Re-exempt the templates. The `.env*` line above is a catch-all added later
# than the `!.env.example` negation further up, and Git takes the LAST
# matching rule -- so without this the documented templates would be silently
# untracked, which is how a deployment ends up with no example to copy.
!.env.example
!**/.env.example

# deployment secrets live only on the VM
deploy/server.env

# field geodata: the source photo archive and anything derived from it
# stay out of Git. 814 MB of JPEGs, and the photos show identifiable people.
Google map*/
campus-field/
