# ===========================================================================
# ECHO ECHO — compose-level configuration for the API host.
#
#   cp .env.example .env    &&    nano .env
#
# NOTHING HERE IS A SECRET. Both values are public: a hostname and a contact
# address. Application secrets live in deploy/server.env, which is chmod 600
# and never committed.
#
# deploy/.env IS committed-adjacent but gitignored, purely so that a wrong
# hostname does not travel with the repository and have Caddy request a
# certificate for a name this VM does not own.
# ===========================================================================

# The hostname the API answers on, and the name on its TLS certificate.
#
# You do NOT need to buy a domain to get here. Two working forms:
#
#   20-197-1-2.sslip.io     the VM's static public IP with dots replaced by
#                           dashes. sslip.io resolves it to that IP, Let's
#                           Encrypt issues a real certificate over HTTP-01,
#                           and no DNS account is involved at all.
#
#   api.echoecho.tech       once the domain exists and an A record for `api`
#                           points at the VM's static public IP.
#
# Whichever you use, it must already resolve to this VM BEFORE the first
# `docker compose up`, or the ACME challenge fails and Caddy backs off.
API_HOSTNAME=

# Where Let's Encrypt sends expiry and problem notices. Use an address you
# actually read; a certificate that silently fails to renew takes the API
# down 90 days later.
ACME_EMAIL=
