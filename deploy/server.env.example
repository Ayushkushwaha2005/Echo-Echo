# ===========================================================================
# ECHO ECHO — production environment for the API container.
#
#   cp server.env.example server.env
#   chmod 600 server.env
#   # fill in every REQUIRED value, then: docker compose up -d
#
# server.env is git-ignored and must stay that way. Nothing in this file is a
# real value: it is the list of names the server reads, with the reason each
# one exists. The server refuses to start if a required one is missing rather
# than running in a state that would quietly misbehave — see
# server/src/config.js, assertBootable().
# ===========================================================================

NODE_ENV=production

# ---- database -------------------------------------------------------------
# REQUIRED. The Azure PostgreSQL Flexible Server connection string.
# Production refuses a localhost URL and refuses a connection without TLS, so
# sslmode must be present.
#   postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/quad?sslmode=require
DATABASE_URL=
PGSSLMODE=require

# ---- identity of this deployment ------------------------------------------
# REQUIRED. The permanent owner. Set once; migrate.js grants platform_owner to
# this mailbox and demotes any previous owner. Do not change it casually.
PLATFORM_OWNER_EMAIL=ayush.17551@stu.upes.ac.in
PLATFORM_OWNER_NAME=Ayush Kushwaha

# ---- HTTP and cookies -----------------------------------------------------
HOST=0.0.0.0
PORT=8080

# REQUIRED. At least 32 random characters. Generate ON THE VM, never in a
# chat window or an editor that syncs:
#   openssl rand -base64 48
# Rotating it invalidates every session and every admin TOTP secret that was
# encrypted with it when ADMIN_TOTP_KEY is unset — so set ADMIN_TOTP_KEY too.
COOKIE_SECRET=

# REQUIRED true in production. The session cookie is Secure; without https it
# would never be stored at all.
SECURE_COOKIES=true

# REQUIRED. Every origin the browser may call the API from, https, no
# localhost and NO trailing slash. With the Vercel /api rewrite the browser's
# origin is the VERCEL site, not the API host -- naming the API host here is
# the commonest way to get "Cross-origin request rejected" on every write.
#   https://echo-echo-nu.vercel.app
# Later, if the domain exists:
#   https://echoecho.tech,https://www.echoecho.tech
WEB_ORIGIN=

# REQUIRED behind Caddy. Without it every request carries the proxy's address
# and the per-IP rate limits collapse into a single shared bucket.
TRUST_PROXY=true

# ---- administrator sign-in -------------------------------------------------
# REQUIRED. The domain administrators sign in on -- the host of WEB_ORIGIN,
# NOT the API host. Only legacy passkeys use it, but the boot guard requires
# it to be set and every WEBAUTHN_ORIGINS entry to be on it or a subdomain.
# A passkey is bound to this value: changing it later invalidates existing
# passkeys, so set it to whatever the surfaces will be served from for good.
WEBAUTHN_RP_ID=echo-echo-nu.vercel.app
WEBAUTHN_ORIGINS=https://echo-echo-nu.vercel.app

# Encrypts admin TOTP secrets at rest. Set it explicitly so the authenticator
# survives a COOKIE_SECRET rotation. Generate on the VM: openssl rand -base64 48
ADMIN_TOTP_KEY=

# ---- email (REQUIRED: students cannot sign in without it) ------------------
# The boot guard has NO deferral flag for email — unlike payments. Production
# will not start until a student sign-in provider exists.
# Resend only delivers to OTHER people's mailboxes from a domain you have
# verified with DNS records, so a sending domain must be verified in Resend
# before any student can receive a code. resend.dev addresses deliver only to
# the Resend account holder's own mailbox and are useless for real students.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
#   e.g. ECHO ECHO <verify@echoecho.tech>
EMAIL_FROM=

# ---- object storage (REQUIRED in production) -------------------------------
# Student ID images and food photos. The local-disk provider is refused in
# production, and it would be wrong here anyway: a container filesystem is
# ephemeral, so ID documents would vanish on redeploy.
# The bucket MUST be private. These are government ID images.
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- payments (deferred, deliberately) -------------------------------------
# No gateway yet, so checkout answers 503 and /ready reports it. This flag is
# the explicit acknowledgement the boot guard demands; without it the server
# refuses to start rather than let ordering fail by accident.
# Remove this line the day the Cashfree KYC completes.
PAYMENTS_DEFERRED=true

# ---- schedulers ------------------------------------------------------------
# Defaults are 30s and 60s. Azure PostgreSQL Flexible Server is always-on, so
# the defaults are correct here. They would NOT be on a scale-to-zero free
# database: a 30-second tick keeps such a database awake around the clock and
# burns its monthly compute allowance.
# SWEEPER_INTERVAL_SECONDS=30
# SETTLEMENT_INTERVAL_SECONDS=60

# ---- logging ---------------------------------------------------------------
LOG_LEVEL=info
