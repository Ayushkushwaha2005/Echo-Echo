# =============================================================================
# QUAD — server configuration
#
# Copy to .env and fill in. Anything left blank makes its feature return a
# truthful "not configured" state rather than pretending to work.
# =============================================================================

# ---- required: the server refuses to start without these -------------------
# Managed Postgres in production. A localhost URL is REFUSED when
# NODE_ENV=production, as is a connection without TLS.
DATABASE_URL=postgres://quad:quad@localhost:5432/quad

# Connection pooling and TLS.
#   PGSSLMODE=require    verify the chain (the default for managed providers)
#   PGSSLMODE=no-verify  provider uses a private CA and you accept that
#   PGSSLROOTCERT_PEM    paste a CA certificate to verify against instead
PGSSLMODE=
PGSSLROOTCERT_PEM=
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000

# Behind a load balancer you control, so X-Forwarded-For can be believed.
# Leave false otherwise: it lets a client spoof its own IP.
TRUST_PROXY=false

# The platform owner: the highest-privilege identity, never grantable,
# revocable or suspendable through any API. Set ONE of:
#   PLATFORM_OWNER_EMAIL  institutional email; the role is granted when that
#                         mailbox is proven with the email code
#   PLATFORM_OWNER_PHONE  E.164 phone (legacy; used by the enrolment-code CLI)
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PHONE=+91XXXXXXXXXX
PLATFORM_OWNER_NAME=Your Name

# Further administrators, by verified institutional email, comma-separated.
# Listing an email grants platform_admin once its mailbox is proven. It does
# NOT let them act: administrator powers need a passkey (below).
PLATFORM_ADMIN_EMAILS=

# ---- administrator sign-in ---------------------------------------------------
# Campus Control is opened with an email, a password and a six-digit code from
# an authenticator app (Microsoft Authenticator, Google Authenticator, 1Password
# - any TOTP app). All three are checked on this server. There is no provider to
# configure: the codes are computed locally from a shared secret (RFC 6238), and
# no biometric data is stored anywhere.
#
# Set up the owner, or any administrator, from the server shell:
#   npm run admin:setup                      (the owner, from PLATFORM_OWNER_EMAIL)
#   npm run admin:setup -- --email a@b.c     (an administrator the owner invited)
#
# Encrypts the stored authenticator secrets (AES-256-GCM). Any long random
# string, at least 32 characters. Falls back to COOKIE_SECRET when unset, but
# set it separately so rotating one does not invalidate the other.
ADMIN_TOTP_KEY=
# The name shown next to the code in the authenticator app.
# Defaults to "ECHO ECHO Campus Control".
ADMIN_TOTP_ISSUER=
# The TOTP time step, and how many steps of clock drift are tolerated either
# way. The defaults are what every authenticator app assumes; changing them
# will stop ordinary apps from working.
ADMIN_TOTP_PERIOD_SECONDS=30
ADMIN_TOTP_WINDOW=1
# Wrong password or code this many times and the administrator account is
# locked for this long. Counted per account, so rotating IP addresses does not
# dilute it.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
# How long an administrator session lasts. Shorter than a student's, because it
# can move money and change permissions.
ADMIN_SESSION_MINUTES=480
# Campus Control sign-in is two screens: email + password, then the
# authenticator code. This is how long the gap between them may be - long
# enough to open the app and read a code, short enough that a proven password
# left on a walked-away-from browser goes stale. The challenge in between is
# single-use and is not a session.
ADMIN_LOGIN_CHALLENGE_SECONDS=300
# After an administrator proves their mailbox with an emailed code, how long
# they have to actually choose the new password. The reset never opens a
# session and never replaces the authenticator.
ADMIN_RESET_TOKEN_MINUTES=15
# Per-IP limit on administrator sign-in attempts, per RL_WINDOW_MINUTES.
RL_ADMIN_LOGIN=20
# Read by `npm run admin:setup` so the password is not typed into a terminal
# that keeps history. Leave unset in a deployed environment; the command asks.
ADMIN_SETUP_PASSWORD=

# ---- administrator passkeys (WebAuthn) ---------------------------------------
# No surface offers a passkey as a sign-in any more. These remain because a
# deployment may still have credentials registered from before, and because the
# gate that requires a STRONG administrator session is still called this.
#
# ADMIN_PASSKEY_REQUIRED=true (the production default, and it cannot be turned
# off in production) means administrator powers need a session opened with the
# password + authenticator flow above.
ADMIN_PASSKEY_REQUIRED=
# The registrable domain administrators sign in on, e.g. echoecho.in
# (required in production). Every WEBAUTHN_ORIGINS entry must be on it.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
# Defaults to WEB_ORIGIN. Comma-separated full origins, e.g. https://admin.echoecho.in
WEBAUTHN_ORIGINS=
# How long a sign-in confirmation counts for money, roles and boundaries.
# Past this, those actions ask for the password and code again.
ADMIN_REAUTH_MINUTES=10
ADMIN_SESSION_TTL_MINUTES=240
# How long a one-time administrator invitation (emailed code) stays valid.
ADMIN_PASSKEY_INVITE_TTL_HOURS=24

# Required in production. Any long random string.
COOKIE_SECRET=

# ---- enrolment codes: the provider-free sign-in path -----------------------
# Needs NOTHING. An admin issues a one-time code in Campus Control and reads
# it out; the platform owner bootstraps with "npm run enrol:owner" on the
# server. This is how Quad is administered with no third party at all.
ENROLMENT_TTL_MINUTES=1440

# ---- per-IP rate limits ----------------------------------------------------
# Generous on purpose: a campus shares a few NAT addresses, so tight per-IP
# caps would lock out everyone. The real limits are per-phone/per-code and
# live in the database.
RL_OTP_SEND=120
RL_OTP_VERIFY=240
RL_ENROL=120
RL_AI=30
RL_WINDOW_MINUTES=10

# ---- OTP: OPTIONAL phone sign-in (paid SMS) --------------------------------
# NOT needed for launch: students sign in with institutional email (above the
# payments section, under "email"). Leave blank to run with zero SMS cost.
# There is no development bypass and no fixed code. This is deliberate.
# Staff and admins can still sign in via enrolment codes without this.
#
# The SERVER generates the code, stores only its salted hash, and verifies
# it. The provider only delivers the text — its "accepted" is never taken as
# proof of anything. Indian numbers need a DLT-registered sender (header)
# and template; the text below must match the registered template exactly.
OTP_PROVIDER=                 # msg91 (recommended for India) | twilio

# --- MSG91 (OTP_PROVIDER=msg91) ---
MSG91_AUTH_KEY=               # MSG91 dashboard > API > Auth key
MSG91_TEMPLATE_ID=            # the Flow/template id of your DLT-approved OTP template
MSG91_SENDER=                 # your DLT-approved 6-character sender id (header)
# MSG91_OTP_VAR=otp           # the variable name in that template (default: otp, for ##otp##)
MSG91_BASE_URL=               # default https://control.msg91.com (https only in production)

# --- Twilio (OTP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                  # a sending number or DLT sender id, or:
TWILIO_MESSAGING_SERVICE_SID= # a Messaging Service (MG...) instead of TWILIO_FROM
TWILIO_BASE_URL=              # default https://api.twilio.com (https only in production)
# Twilio Verify is intentionally not supported: it would make Twilio, not
# this server, the party that decides whether a code is correct.

# The text sent by providers that take free text (Twilio). {code} and
# {minutes} are substituted. Must match your DLT template character for character.
# OTP_SMS_TEXT={code} is your ECHO ECHO verification code. It expires in {minutes} minutes. Do not share it.

# Codes are only sent to numbers starting with one of these (SMS toll-fraud guard).
# OTP_ALLOWED_PREFIXES=+91     # default
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=45
OTP_MAX_SENDS_PER_HOUR=6

# ---- payments: without this, no order can be placed ------------------------
# There is no cash-on-delivery path in this product.
#
#   cashfree   Cashfree Payment Gateway  — recommended for the pilot.
#   razorpay   Razorpay                  — the original integration, still supported.
#
# Which one is a deployment decision: src/services/payment-providers.js holds
# one adapter each and nothing outside it names a gateway, so switching is a
# config change rather than a rewrite.
#
# On pricing: do NOT assume the 0% platform-fee promotion applies. It is
# limited to merchants who signed up on or after 21 Jul 2026, capped at
# ₹20,00,000 cumulative GMV and ending 31 Mar 2027; the standard rate is
# 1.95% + tax. Confirm your own account's terms in the Cashfree dashboard.
# Quad never assumes a rate either way — gateway charges are recorded from
# actual provider data or reported as not-yet-known.
PAYMENT_PROVIDER=             # cashfree | razorpay

# Deploying before payment KYC: production refuses to start without a
# provider unless this acknowledgement is set. Ordering stays unavailable
# (checkout returns 503) and /ready reports it. Remove once the gateway is live.
PAYMENTS_DEFERRED=

# How far out of date a provider-timestamped webhook may be before it is
# refused as a replay, even with a valid signature. Cashfree signs the
# timestamp into the HMAC, so this is a real guard rather than a decoration.
PAYMENT_WEBHOOK_MAX_SKEW_SECONDS=300

# --- Cashfree Payment Gateway (PAYMENT_PROVIDER=cashfree) ---
# The SAME secret key authenticates the API and verifies webhook signatures,
# so there is no separate webhook secret and no way to configure collection
# without being able to verify a webhook.
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=
CASHFREE_PG_API_VERSION=2026-01-01
# Sandbox is https://sandbox.cashfree.com. Production refuses non-https.
CASHFREE_PG_BASE_URL=https://api.cashfree.com
# How many days back the scheduled settlement reconciliation re-reads on each
# daily run. Settlement lands days after capture and a provider may restate a
# report, so a rolling window is correct; re-reading a reconciled day is free
# because every line is refused by its unique index.
RECON_LOOKBACK_DAYS=7

# Where the hosted checkout sends the customer back to. Server-configured on
# purpose: a return URL a client could influence is an open redirect with a
# payment attached. Blank is fine — the browser polls /payments/status, which
# asks the gateway itself rather than believing the redirect.
CASHFREE_PG_RETURN_URL=

# --- Razorpay (PAYMENT_PROVIDER=razorpay) ---
# Override only to route through your own egress proxy. Production refuses
# any value that is not https, so a test stub can never leak into a
# production deployment.
RAZORPAY_BASE_URL=            # default https://api.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=      # an order is confirmed ONLY by a signed webhook

# ---- AI ordering assistant -------------------------------------------------
AI_PROVIDER=                  # anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Ceiling on tool-use round trips per conversation turn.
AI_MAX_TURNS=8

# ---- ID verification -------------------------------------------------------
# Without OCR, submissions go straight to manual admin review (still correct,
# just slower). Nothing is ever auto-approved either way.
OCR_PROVIDER=                 # gcv
GCV_API_KEY=

# The authoritative student cross-check. No public UPES API is known; this
# stays empty until the university provides a roster export or SSO.
ROSTER_PROVIDER=              # csv | api
ROSTER_CSV_PATH=
ROSTER_API_URL=
ROSTER_API_KEY=

# ---- campus live location ------------------------------------------------
# A browser GPS fix less precise than this (metres) is refused instead of
# being used to suggest delivery spots. Orders always target a configured
# campus location regardless.
CAMPUS_GPS_MAX_ACCURACY_M=100
# Imported field GPS points worse than this (metres) are flagged in the preview.
GEO_IMPORT_MAX_ACCURACY_M=25

# ---- storage ---------------------------------------------------------------
# Production REQUIRES s3. Local disk is refused when NODE_ENV=production.
STORAGE_PROVIDER=local        # local | s3
STORAGE_LOCAL_DIR=./var/uploads
UPLOAD_MAX_BYTES=8388608
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                  # set for Cloudflare R2 / MinIO; blank for AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ID-card images are deleted this many days after a case is decided.
ID_IMAGE_RETENTION_DAYS=90

# ---- email: STUDENT SIGN-IN AND VERIFICATION (zero-cost, no SMS) -----------
# This is the student sign-in path for the zero-cost launch. The server sends
# a one-time code to the student's university mailbox and verifies it itself;
# control of that mailbox is what proves student status. See
# docs/STUDENT-VERIFICATION.md. Also used for email notifications.
#
# Resend Free plan (checked 13 Sep 2026 on resend.com/pricing): 3,000
# emails/month, 100/day, no overage billing (sends past the quota are refused
# with HTTP 429). Resend only delivers to other people's mailboxes from a
# domain YOU have verified with DNS records - resend.dev cannot email students.
# EMAIL_FROM must be an address on that verified (sub)domain.
EMAIL_PROVIDER=               # resend
RESEND_API_KEY=               # a "Sending access" key restricted to your domain
EMAIL_FROM=                   # e.g. ECHO ECHO <verify@mail.your-domain>
RESEND_BASE_URL=              # default https://api.resend.com (https only in production)

# The server counts every send and stops BELOW the free quota, so abuse cannot
# drain it and nothing is ever billed. The reserve is kept for administrator
# invitations only. Raise these only if you move to a paid plan.
EMAIL_DAILY_BUDGET=95
EMAIL_MONTHLY_BUDGET=2900
EMAIL_ADMIN_RESERVE=5
# Codes one network address may request per hour, across all mailboxes.
# Campus Wi-Fi shares a few NAT addresses, so keep this generous.
EMAIL_CODE_MAX_SENDS_PER_IP_HOUR=30

# Exact domains only - no subdomains or lookalikes are ever accepted.
# Blank means the default: stu.upes.ac.in. Comma-separated for more campuses.
STUDENT_EMAIL_DOMAINS=
# false: proving the mailbox makes the student VERIFIED.
# true:  proving the mailbox opens an admin review case instead.
STUDENT_EMAIL_REQUIRES_ADMIN_REVIEW=false
# 0 = off. Days after which a mailbox-verified student must prove the mailbox
# again before ordering (alumni-mailbox mitigation; see docs/STUDENT-VERIFICATION.md).
STUDENT_EMAIL_REVERIFY_DAYS=0
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN=60
EMAIL_CODE_MAX_SENDS_PER_HOUR=5
EMAIL_CODE_MAX_SENDS_PER_DAY=12
RL_EMAIL_SEND=120
RL_EMAIL_VERIFY=240

# ---- background sweeper ----------------------------------------------------
# Expires delivery offers, cancels unpaid orders, purges old ID images.
# Set to "off" on instances that should not run it.
SWEEPER=
# How often the sweeper and the settlement scheduler query the database.
# Every tick wakes a scale-to-zero database (Neon Free: suspends after 5 idle
# minutes, 100 CU-hours/month). While PAYMENTS_DEFERRED=true there are no
# orders to expire, so on the free tier set SWEEPER=off, or raise these.
SWEEPER_INTERVAL_SECONDS=30
SETTLEMENT_INTERVAL_SECONDS=60

# ---- http ------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Comma-separated list of allowed browser origins.
WEB_ORIGIN=http://localhost:3000
# MUST be true in production; the boot guard refuses otherwise.
SECURE_COOKIES=false
SESSION_TTL_MINUTES=720

# ---------- payouts / settlement ------------------------------------------
# Collecting payments and paying out cafeterias/partners are separate
# products. A plain payment-gateway account does the first only.
#
# Leave PAYOUT_PROVIDER unset to settle by administrator-recorded bank
# transfer — the ledger tracks what is owed either way, and nothing is ever
# marked paid without a real bank reference. Set it once a payout account has
# been opened and each payee provisioned there as a beneficiary.
#
#   cashfree   Cashfree Payouts   — recommended for the pilot: pay-per-transfer,
#                                   no subscription. See docs/PAYMENTS-PROVIDER.md
#   razorpayx  RazorpayX Payouts  — requires a quarterly subscription plan
#
# Quad never stores a bank account number for either. Only the provider's
# opaque payee id is kept, in payout_destination.
PAYOUT_PROVIDER=

# --- Cashfree Payouts (PAYOUT_PROVIDER=cashfree) ---
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_MODE=imps
CASHFREE_PAYOUT_API_VERSION=2024-01-01
# Sandbox is https://sandbox.cashfree.com. Production refuses non-https.
CASHFREE_PAYOUT_BASE_URL=https://api.cashfree.com

# --- RazorpayX Payouts (PAYOUT_PROVIDER=razorpayx) ---
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_MODE=IMPS
# Override only for an egress proxy, or to point the adapter at a local stub
# in tests. Production refuses anything that is not https.
RAZORPAYX_BASE_URL=https://api.razorpay.com
